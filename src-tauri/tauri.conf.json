{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReClaim Cleaner",
  "mainBinaryName": "reclaim-cleaner",
  "version": "../package.json",
  "identifier": "io.github.yusufky63.reclaim",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReClaim Cleaner",
        "width": 1320,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "yusufky63",
    "copyright": "Copyright (c) 2026 yusufky63 and contributors",
    "category": "Utility",
    "shortDescription": "Disk cleaner and space analyzer for Windows",
    "longDescription": "ReClaim Cleaner shows where your disk space went and removes caches, temp files, build artifacts, duplicates and old installers safely, with a preview before every delete.",
    "homepage": "https://github.com/yusufky63/reclaim-cleaner",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "language": ["en-US", "tr-TR"],
        "upgradeCode": "93A4F048-2E53-418D-A52F-361DA387369B"
      }
    }
  }
}
